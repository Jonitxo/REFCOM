{
 "name": "Referencias por modelo",
 "short_name": "Referencias",
 "start_url": "./",
 "scope": "./",
 "display": "standalone",
 "background_color": "#eef2f1",
 "theme_color": "#00739a",
 "lang": "es",
 "icons": [
  {
   "src": "icon-192.png",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "any maskable"
  },
  {
   "src": "icon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "any maskable"
  }
 ],
 "share_target": {
  "action": "./share-target",
  "method": "POST",
  "enctype": "multipart/form-data",
  "params": {
   "files": [
    {
     "name": "file",
     "accept": [
      ".xlsx",
      ".xlsm",
      ".csv",
      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
      "application/vnd.ms-excel.sheet.macroEnabled.12",
      "text/csv"
     ]
    }
   ]
  }
 }
}